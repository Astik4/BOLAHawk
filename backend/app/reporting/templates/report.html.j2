<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>API Security Testing Platform — Findings Report</title>
<style>
  :root {
    --bg: #0f1115; --panel: #161a21; --border: #262b35;
    --text: #e6e9ef; --muted: #8b93a3;
    --critical: #e5484d; --high: #f2994a; --medium: #f2c94c; --low: #56ccf2; --none: #6b7280;
  }
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--text); margin: 0; padding: 40px; }
  .header { border-bottom: 1px solid var(--border); padding-bottom: 20px; margin-bottom: 30px; }
  .header h1 { margin: 0 0 8px 0; font-size: 24px; }
  .meta { color: var(--muted); font-size: 13px; }
  .summary { display: flex; gap: 16px; margin-bottom: 32px; }
  .summary .card { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 16px 20px; flex: 1; }
  .summary .card .num { font-size: 28px; font-weight: 700; }
  .summary .card .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; }
  .sev-Critical .num { color: var(--critical); }
  .sev-High .num { color: var(--high); }
  .sev-Medium .num { color: var(--medium); }
  .sev-Low .num { color: var(--low); }
  .finding { background: var(--panel); border: 1px solid var(--border); border-left: 4px solid var(--muted); border-radius: 6px; padding: 16px 20px; margin-bottom: 14px; }
  .finding.Critical { border-left-color: var(--critical); }
  .finding.High { border-left-color: var(--high); }
  .finding.Medium { border-left-color: var(--medium); }
  .finding.Low { border-left-color: var(--low); }
  .finding-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
  .finding-title { font-weight: 600; font-size: 15px; }
  .badge { font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 700; }
  .badge.Critical { background: var(--critical); color: #1a0505; }
  .badge.High { background: var(--high); color: #1a0f00; }
  .badge.Medium { background: var(--medium); color: #1a1500; }
  .badge.Low { background: var(--low); color: #001a1a; }
  .finding-meta { color: var(--muted); font-size: 12px; margin-bottom: 10px; }
  .finding p { margin: 6px 0; font-size: 13px; line-height: 1.5; }
  .finding .label { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; }
  code { background: #0a0c10; padding: 1px 5px; border-radius: 3px; font-size: 12px; }
</style>
</head>
<body>
  <div class="header">
    <h1>API Security Testing Platform — Findings Report</h1>
    <div class="meta">
      Scan ID: {{ scan_id }} &middot;
      Status: {{ status }} &middot;
      Started: {{ started_at }} &middot;
      Generated: {{ generated_at }}
    </div>
  </div>

  <div class="summary">
    <div class="card">
      <div class="num">{{ summary.total_findings }}</div>
      <div class="label">Total Findings</div>
    </div>
    {% for sev in ["Critical", "High", "Medium", "Low"] %}
    <div class="card sev-{{ sev }}">
      <div class="num">{{ summary.by_severity.get(sev, 0) }}</div>
      <div class="label">{{ sev }}</div>
    </div>
    {% endfor %}
    <div class="card">
      <div class="num">{{ "%.1f"|format(summary.highest_score) }}</div>
      <div class="label">Highest CVSS</div>
    </div>
  </div>

  {% for f in findings %}
  <div class="finding {{ f.severity }}">
    <div class="finding-top">
      <div class="finding-title">{{ f.title }}</div>
      <div class="badge {{ f.severity }}">{{ f.severity }} — CVSS {{ "%.1f"|format(f.cvss_score) }}</div>
    </div>
    <div class="finding-meta">{{ f.check_id }} &middot; {{ f.method }} {{ f.endpoint }} &middot; context: {{ f.auth_context }}</div>
    <p><span class="label">Description</span><br>{{ f.description }}</p>
    <p><span class="label">Evidence</span><br><code>{{ f.evidence }}</code></p>
    <p><span class="label">Remediation</span><br>{{ f.remediation }}</p>
    <p><span class="label">CVSS Vector</span><br><code>{{ f.cvss_vector }}</code></p>
  </div>
  {% else %}
  <p>No findings recorded for this scan.</p>
  {% endfor %}
</body>
</html>
